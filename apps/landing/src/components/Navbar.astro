---
import { useTranslations } from '../i18n'
import './Navbar.css'

interface Props {
  lang: string
}
const { lang } = Astro.props

const t = useTranslations(lang).navbar

const links = [
  {
    text: t.projects,
    to: '#projects',
  },
  {
    text: t.skills,
    to: '#skills',
  },
  {
    text: t.experience,
    to: '#work-experience',
  },
]
---

<header>
  <nav class='container'>
    <ul>
      {
        links.map((link) => (
          <li>
            <a href={link.to}>{link.text}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
