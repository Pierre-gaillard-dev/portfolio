---
import Background from '../../components/Background.astro'
import Head from '../../components/Head.astro'
import Navbar from '../../components/Navbar.astro'
import { defaultLanguage, languages, useTranslations } from '../../i18n'
import Footer from '../../partials/home/Footer.astro'
import Hero from '../../partials/home/Hero.astro'
import Projects from '../../partials/home/Projects.astro'
import Skills from '../../partials/home/Skills.astro'
import { urlFor } from '../../utils/urlFor'

export function getStaticPaths() {
  const paths = [undefined, ...languages]
    .map((l) => ({
      params: { lang: l },
    }))
    .filter((path) => path.params.lang != defaultLanguage)

  console.log(
    `created home routes for languages ${paths.map((p) => p.params.lang).join(',')} `
  )
  return paths
}

const { lang = 'fr' } = Astro.params

const t = useTranslations(lang)

const alternates = languages.map((l) => ({ lang: l, url: urlFor(l) }))

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: t.home.hero.name,
  jobTitle: t.home.hero.job,
  url: urlFor(lang),
  image: new URL('/img/photo.png', Astro.site).href,
}
---

<html lang={lang}>
  <Head
    title={t.home.title}
    description={t.home['meta-description']}
    lang={lang}
    alternates={alternates}
  >
    <script type='application/ld+json' set:html={JSON.stringify(person)} />
  </Head>
  <body id='page-home'>
    <Background />
    <Navbar lang={lang} />
    <Hero lang={lang} />
    <Projects lang={lang} />
    <Skills lang={lang} />
    <Footer lang={lang} />
  </body>
</html>
