---
import Head from '../../components/Head.astro'
import Navbar from '../../components/Navbar.astro'
import { defaultLanguage, languages } from '../../i18n'
import Hero from '../../partials/home/Hero.astro'
import Projects from '../../partials/home/Projects.astro'

export function getStaticPaths() {
  const paths = [undefined, ...languages]
    .map((l) => ({
      params: { lang: l },
    }))
    .filter((path) => path.params.lang != defaultLanguage)

  console.log(
    `created home routes for languages ${paths.map((p) => p.params.lang).join(',')} `
  )
  return paths
}

const { lang = 'fr' } = Astro.params
---

<html lang={lang}>
  <Head>
    <title>Astro</title>
  </Head>
  <body id='page-home'>
    <Navbar lang={lang} />
    <Hero lang={lang} />
    <Projects lang={lang} />
  </body>
</html>
