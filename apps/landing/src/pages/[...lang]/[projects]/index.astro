---
import Background from '../../../components/Background.astro'
import Breadcrumb from '../../../components/Breadcrumb.astro'
import Head from '../../../components/Head.astro'
import Navbar from '../../../components/Navbar.astro'
import ProjectCard from '../../../components/ProjectCard.astro'
import { getProjects } from '../../../data/projects/projects.queries'
import { defaultLanguage, languages, useTranslations } from '../../../i18n'
import { urlFor } from '../../../utils/urlFor'
import './index.css'

export function getStaticPaths() {
  const paths = [undefined, ...languages]
    .map((l) => {
      const t = useTranslations(l)
      return {
        params: { lang: l, projects: t.url.projects },
      }
    })
    .filter((path) => path.params.lang != defaultLanguage)

  console.log(
    `created home routes for languages ${paths.map((p) => p.params.lang).join(',')} `
  )
  return paths
}

const { lang = 'fr' } = Astro.params

const t = useTranslations(lang)

const projects = await getProjects(lang)
---

<html>
  <Head>
    <title></title>
  </Head>
  <body class='projects'>
    <Background />
    <Navbar lang={lang} />
    <section>
      <Breadcrumb
        parts={[
          { name: t.navbar.home, url: urlFor(lang) },
          { name: t.navbar.projects, url: urlFor(lang, t.url.projects) },
        ]}
      />
      <h1>Projects</h1>
    </section>
    <section>
      <ul class='project-list'>
        {
          projects.map((project) => (
            <li>
              <ProjectCard lang={lang} project={project} />
            </li>
          ))
        }
      </ul>
    </section>
  </body>
</html>
