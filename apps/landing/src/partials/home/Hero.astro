---
import NavMap from '../../components/NavMap.astro'
import { cvUrl, emailUrl, githubUrl } from '../../data/const'
import { useTranslations } from '../../i18n'
import './Hero.css'

interface Props {
  lang: string
}
const { lang } = Astro.props

const t = useTranslations(lang).home.hero
---

<section id='hero'>
  <div class='container'>
    <h2>{t.job}</h2>
    <h1>{t.name}</h1>
    <p>{t.description}</p>
    <ul>
      <li>
        <a 
          href={githubUrl}
           target="_blank"
           rel="noopener noreferrer"
        > {t.links.github} </a>
      </li>
      <li>
        <a 
          href={emailUrl}
           target="_blank"
           rel="noopener noreferrer"
        >
          {t.links.contact}
        </a>
      </li>
      <li>
        <a
          href={cvUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.links.cv}
        </a>
      </li>
    </ul>
  </div>
  <NavMap lang={lang} />
</section>
